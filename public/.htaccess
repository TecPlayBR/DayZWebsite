# ============================================================
# Tecplay - DayZ Website Template
# ============================================================
# Rewrite tudo pra index.php (front controller pattern)
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forca HTTPS (descomente se voce tem SSL ativado no dominio)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Permite acesso direto a arquivos/pastas reais (imagens, css, js)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tudo o resto -> index.php
    RewriteRule ^ index.php [L]
</IfModule>

# Cache de assets estaticos (1 ano - assets versionados por nome)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css   "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Compressao
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml application/json
</IfModule>

# Cache headers via mod_headers (fallback se ExpiresActive nao funciona)
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|woff2|woff|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    # Seguranca: no cache pro HTML dinamico
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Seguranca: headers de protecao (defesa em profundidade).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS: o navegador so honra sobre HTTPS (em HTTP e ignorado, entao e seguro).
    # Sem includeSubDomains/preload pra nao afetar subdominio HTTP-only do cliente.
    Header always set Strict-Transport-Security "max-age=31536000"
    # CSP BLOQUEANDO (antes era so Report-Only, que avisa e deixa passar).
    #
    # A instrucao antiga aqui dizia "trocar pra enforce quando os reports confirmarem que
    # nada legitimo viola". Os reports confirmaram:
    #
    # Report-only nao protege ninguem: ele avisa e deixa passar. Ficou assim por medo de
    # quebrar site de cliente, e o medo tinha fundamento. Mas a evidencia agora existe:
    #
    #   - um cliente roda ESTA MESMA politica, byte a byte, BLOQUEANDO, num site ao vivo,
    #     e o log de violacao dele esta em ZERO;
    #   - o outro cliente rodou em report-only e tambem registrou ZERO;
    #   - o endpoint de report foi testado e GRAVA (204 + linha no log), entao "zero" e
    #     zero de verdade, e nao um endpoint quebrado fingindo silencio.
    #
    # Se algum dia um cliente precisar de um dominio a mais (um CDN, um player de video),
    # o caminho e ACRESCENTAR a origem aqui, nunca voltar pra report-only: voltar desliga a
    # protecao de todos por causa de um.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://sdk.mercadopago.com https://*.mlstatic.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; frame-src https://www.mercadopago.com https://www.mercadopago.com.br https://mercadopago.com https://*.mercadolibre.com https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self' https://api.mercadopago.com https://*.mercadolibre.com https://*.mlstatic.com; base-uri 'self'; form-action 'self' https://www.mercadopago.com https://www.mercadopago.com.br; frame-ancestors 'self'; report-uri /api/csp-report.php"
</IfModule>

# Bloqueia indexacao de diretorios
Options -Indexes

# Bloqueia acesso a arquivos sensiveis (defesa em profundidade)
<FilesMatch "\.(env|sql|md|log|json|lock)$">
    Require all denied
</FilesMatch>
